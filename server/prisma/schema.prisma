datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum OrderStatus {
  CONFIRMED
  PAYMENT_PENDING
  ADVANCE_PAID
  FULLY_PAID
  SOURCING
  QC_PENDING
  QC_PASSED
  QC_FAILED
  REPACKING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  BALANCE
  FULL
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum InquiryStatus {
  PENDING
  REVIEWING
  QUOTED
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
}

enum QCStatus {
  PENDING
  PASSED
  FAILED
}

enum ShipmentStatus {
  PREPARING
  DISPATCHED
  IN_TRANSIT
  CUSTOMS
  DELIVERED
}

enum RequestStatus {
  SUBMITTED
  REVIEWING
  QUOTED
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
}

enum RequestItemStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  COUNTERED
}

enum RequestItemType {
  CATALOG
  CUSTOM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role      @default(CLIENT)
  staffRole       String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  client             Client?
  refreshTokens      RefreshToken[]
  qcChecks           QualityCheck[]
  emailVerifications EmailVerification[]
  requestActivities  RequestActivity[]
  requestMessages    RequestMessage[]
  verifiedPayments        Payment[]        @relation("PaymentVerifiedBy")
  verifiedRequestPayments RequestPayment[] @relation("RequestPaymentVerifiedBy")

  @@index([email])
  @@map("users")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id           String   @id @default(uuid())
  userId       String   @unique
  companyName  String
  gstin        String?  @unique
  addressLine1 String?
  city         String?
  state        String?
  pincode      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  inquiries        Inquiry[]
  orders           Order[]
  sourcingRequests SourcingRequest[]

  @@map("clients")
}

model Supplier {
  id           String   @id @default(uuid())
  companyName  String
  country      String   @default("China")
  city         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products   Product[]
  orderItems OrderItem[]

  @@map("suppliers")
}

model ProductCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  parentId    String?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@map("product_categories")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  unit        String    @default("PCS")
  moq         Int       @default(1)
  basePrice   Decimal   @db.Decimal(12, 2)
  currency    String    @default("CNY")
  supplierId  String
  categoryId  String
  images      String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  inquiryItems  InquiryItem[]
  orderItems    OrderItem[]
  requestItems  RequestItem[]

  @@index([slug])
  @@index([supplierId])
  @@map("products")
}

model Inquiry {
  id            String        @id @default(uuid())
  inquiryNumber String        @unique
  clientId      String
  notes         String?
  staffNotes    String?
  status        InquiryStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client Client        @relation(fields: [clientId], references: [id])
  items  InquiryItem[]

  @@index([clientId])
  @@map("inquiries")
}

model InquiryItem {
  id                 String        @id @default(uuid())
  inquiryId          String
  type               String        @default("CUSTOM")
  productId          String?
  productName        String
  productDescription String?
  quantity           Int
  unit               String        @default("PCS")
  targetPricePerUnit Decimal?      @db.Decimal(12, 2)
  quotedPrice        Decimal?      @db.Decimal(12, 2)
  notes              String?
  status             InquiryStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  inquiry Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([inquiryId])
  @@map("inquiry_items")
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  clientId          String
  status            OrderStatus @default(CONFIRMED)
  subtotalINR       Decimal     @db.Decimal(12, 2)
  shippingCostINR   Decimal     @db.Decimal(12, 2) @default(0)
  taxINR            Decimal     @db.Decimal(12, 2) @default(0)
  totalINR          Decimal     @db.Decimal(12, 2)
  advanceAmountINR  Decimal?    @db.Decimal(12, 2)
  notes             String?
  gstInvoice        Json?
  completedStages   String[]    @default([])
  deliveryPreference String?
  deliveryAddress    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  client          Client           @relation(fields: [clientId], references: [id])
  items           OrderItem[]
  shipment        Shipment?
  payments        Payment[]
  warehouseReport WarehouseReport?

  @@index([clientId])
  @@index([orderNumber])
  @@map("orders")
}

model WarehouseReport {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])

  itemReports     Json?
  reportSubmitted Boolean  @default(false)

  repackPhotos    String[] @default([])
  warehouseNote   String?
  photosSentAt    DateTime?
  finalWeightKg   Float?
  finalVolumeCbm  Float?
  repackNotes     String?
  repackSaved     Boolean  @default(false)

  outboundTrackingId String?
  packingListUrl     String?
  deliverySlipUrl    String?
  sentToChina        Boolean  @default(false)

  adminReplies    Json?

  isReadByAdmin   Boolean   @default(false)
  isReadByStaff   Boolean   @default(false)
  lastUpdatedAt   DateTime?

  clientApproved     Boolean?
  clientConcern      String?
  clientReviewedAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("warehouse_reports")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  type              PaymentType
  amountINR         Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  proofImageBase64  String?
  proofFileName     String?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  verifiedByUserId  String?
  rejectedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("PaymentVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String?
  supplierId   String?
  quantity     Int
  unitPriceCNY Decimal @db.Decimal(12, 2)
  unitPriceINR Decimal @db.Decimal(12, 2)
  totalINR     Decimal @db.Decimal(12, 2)
  notes        String?
  imageUrl     String?

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product?     @relation(fields: [productId], references: [id])
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  qcCheck  QualityCheck?

  @@map("order_items")
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String         @unique
  trackingNumber    String?
  carrier           String?
  status            ShipmentStatus @default(PREPARING)
  dispatchedAt      DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

model QualityCheck {
  id              String    @id @default(uuid())
  orderItemId     String    @unique
  checkedByUserId String
  status          QCStatus  @default(PENDING)
  notes           String?
  images          String[]
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())

  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])
  checkedByUser User      @relation(fields: [checkedByUserId], references: [id])

  @@map("quality_checks")
}

model SourcingRequest {
  id               String        @id @default(uuid())
  requestNumber    String        @unique
  clientId         String
  status           RequestStatus @default(SUBMITTED)
  totalBudgetINR   Decimal?      @db.Decimal(12, 2)
  advanceAmountINR Decimal?      @db.Decimal(12, 2)
  notes            String?
  referenceNote    String?
  staffNotes       String?
  quotedAt         DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  convertedOrderId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client     Client            @relation(fields: [clientId], references: [id])
  items      RequestItem[]
  activities RequestActivity[]
  messages   RequestMessage[]
  payments   RequestPayment[]

  @@index([clientId])
  @@index([requestNumber])
  @@map("sourcing_requests")
}

model RequestItem {
  id                 String            @id @default(uuid())
  requestId          String
  type               RequestItemType
  productId          String?
  productName        String
  productDescription String?
  quantity           Int
  unit               String            @default("PCS")
  targetPriceINR     Decimal?          @db.Decimal(12, 2)
  quotedRMB          Decimal?          @db.Decimal(12, 2)
  quotedINR          Decimal?          @db.Decimal(12, 2)
  imageUrl           String?
  referenceImageUrls String[]
  status             RequestItemStatus @default(PENDING)
  clientResponse     String?
  counterPriceINR    Decimal?          @db.Decimal(12, 2)
  counterNote        String?
  respondedAt        DateTime?
  notes              String?
  createdAt          DateTime          @default(now())

  request SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([requestId])
  @@map("request_items")
}

model RequestActivity {
  id        String   @id @default(uuid())
  requestId String
  userId    String
  action    String
  createdAt DateTime @default(now())

  request SourcingRequest @relation(fields: [requestId], references: [id])
  user    User            @relation(fields: [userId], references: [id])

  @@map("request_activities")
}

model RequestMessage {
  id        String   @id @default(uuid())
  requestId String
  senderId  String
  senderRole String
  text      String
  createdAt DateTime @default(now())

  request SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User            @relation(fields: [senderId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_messages")
}

model RequestPayment {
  id               String        @id @default(uuid())
  requestId        String
  type             PaymentType
  amountINR        Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(SUBMITTED)
  proofImageBase64 String?
  proofFileName    String?
  submittedAt      DateTime?
  verifiedAt       DateTime?
  verifiedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  request    SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  verifiedBy User?           @relation("RequestPaymentVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([requestId])
  @@map("request_payments")
}
